    vc:hasPart ngm:gaze-tracking ;
    vc:hasPart ngm:gesture-recognition ;
    vc:hasPart ngm:hand-tracking ;
    vc:hasPart ngm:haptic-feedback ;
    vc:hasPart ngm:voice-input ;
    vc:isPartOf ngm:extended-reality ;
    vc:isPartOf ngm:spatial-computing ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:augmented-reality ;
    vc:relatedTo ngm:embodied-interaction ;
    vc:relatedTo ngm:mixed-reality ;
    vc:relatedTo ngm:virtual-reality ;
