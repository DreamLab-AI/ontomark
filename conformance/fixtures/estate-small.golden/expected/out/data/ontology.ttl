ngm:a-b-testing a owl:Class ;
    rdfs:comment "A/B testing is a controlled experimentation method that compares two or more variants by randomly assigning subjects to each and measuring a defined outcome metric. By holding all factors constant except the variant under test, it isolates causal effects and supports data-driven decisions with statistical rigour. It is widely used to optimise digital products, content and user experiences."@en ;
    rdfs:label "A/B Testing"@en ;
    rdfs:subClassOf ngm:data-analytics ;
