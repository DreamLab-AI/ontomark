    vc:uses ngm:scene-graph ;
    vc:uses ngm:shader ;
    vc:uses ngm:texture-mapping .
ngm:3-d-rendering-engine a owl:Class ;
    rdfs:comment "A 3D rendering engine is software that converts three-dimensional geometric data into two-dimensional images through processes including geometry processing, lighting calculation, texture mapping, and rasterisation or ray tracing. In real-time contexts it targets interactive frame rates (90 Hz+) and must minimise motion-to-photon latency for XR presence."@en ;
    rdfs:label "3D Rendering Engine"@en ;
    rdfs:subClassOf ngm:computer-graphics ;
    vc:bridgesTo ngm:inference ;
    vc:bridgesTo ngm:metaverse ;
    vc:contrastsWith ngm:offline-rendering ;
