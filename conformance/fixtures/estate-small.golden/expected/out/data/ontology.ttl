ngm:3-d-asset a owl:Class ;
    rdfs:comment "A 3D Asset is a discrete, self-contained digital artefact encoding three-dimensional geometry, surface materials, skeletal animation rigs, and associated metadata in a machine-readable interchange format such as glTF 2.0, USD, FBX, or OBJ. Such assets are produced by digital content creation tools, stored in asset management systems with versioning and provenance records, and consumed at runtime by rendering engines, game engines, and spatial computing platforms. Production-quality 3D assets typically incorporate multiple levels of detail (LOD), physically-based rendering (PBR) material maps (albedo, metallic-roughness, normal, occlusion, emissive), collision meshes for physics simulation, and compressed texture atlases optimised for a target hardware envelope. Cross-platform delivery relies on open standards maintained by the Khronos Group and Pixar/Academy Software Foundation, enabling asset reuse across metaverse environments, digital twins, extended reality (XR) applications, and game titles."@en ;
    rdfs:label "3D Asset"@en ;
    rdfs:subClassOf ngm:digital-asset ;
    vc:bridgesTo ngm:generative-ai ;
    vc:bridgesTo ngm:neural-radiance-field ;
    vc:bridgesTo ngm:non-fungible-token ;
    vc:contrastsWith ngm:voxel ;
    vc:enables ngm:digital-twin ;
    vc:enables ngm:extended-reality ;
    vc:enables ngm:metaverse ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:level-of-detail ;
    vc:hasPart ngm:polygon-mesh ;
    vc:hasPart ngm:skeletal-rig ;
    vc:hasPart ngm:texture-map ;
    vc:qualityScore "0.72"^^xsd:float ;
    vc:relatedTo ngm:game-engine ;
    vc:relatedTo ngm:scene-graph ;
    vc:relatedTo ngm:spatial-computing ;
    vc:requires ngm:asset-pipeline ;
    vc:requires ngm:digital-content-creation ;
    vc:requires ngm:physically-based-rendering ;
    vc:slug "3-d-asset" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation ;
    vc:standardizedBy ngm:khronos-group ;
    vc:standardizedBy ngm:w3-c ;
    vc:uses ngm:digital-asset-management ;
    vc:uses ngm:gltf-standard ;
    vc:uses ngm:texture-compression ;
    vc:uses ngm:universal-scene-description .
ngm:3-d-asset-standard a owl:Class ;
    rdfs:comment "A 3D Asset Standard is a formal specification defining the file formats, metadata schemas, coordinate systems, material models, animation encodings, and interoperability protocols required for consistent creation, exchange, and real-time rendering of three-dimensional digital content across diverse software platforms and runtime environments. Such standards normalise vertex data structures, physically based rendering (PBR) material pipelines, level-of-detail hierarchies, skeletal animation rigs, and compression algorithms so that assets created in one authoring tool function correctly in another without manual conversion or data loss. Prominent examples include the Khronos Group glTF 2.0 specification for web and mobile 3D delivery, Pixar's Universal Scene Description (USD/USDZ) for complex scene composition, and the Metaverse Standards Forum interoperability profiles. These specifications underpin spatial computing, extended reality, game engines, digital-twin platforms, and emerging metaverse ecosystems by ensuring deterministic visual fidelity and semantic asset identity across the entire content pipeline."@en ;
    rdfs:label "3D Asset Standard"@en ;
    rdfs:subClassOf ngm:interoperability-standard ;
    vc:bridgesTo ngm:non-fungible-token ;
    vc:bridgesTo ngm:semantic-web-linked-data-standard ;
    vc:contrastsWith ngm:fbx ;
    vc:enables ngm:asset-interoperability ;
    vc:enables ngm:digital-twin ;
    vc:enables ngm:extended-reality ;
    vc:enables ngm:real-time-rendering ;
    vc:hasMaturity ngmi:maturity-established ;
    vc:hasPart ngm:gltf-standard ;
    vc:hasPart ngm:level-of-detail ;
    vc:hasPart ngm:physically-based-rendering ;
    vc:hasPart ngm:universal-scene-description ;
    vc:implements ngm:iso-iec-14496-16 ;
    vc:implements ngm:open-standard ;
    vc:qualityScore "0.74"^^xsd:float ;
    vc:relatedTo ngm:digital-content-creation ;
    vc:relatedTo ngm:iso-iec-14496-16 ;
    vc:relatedTo ngm:spatial-web ;
    vc:requires ngm:coordinate-system ;
    vc:requires ngm:mesh-compression ;
    vc:requires ngm:texture-atlas ;
    vc:slug "3-d-asset-standard" ;
    vc:sourceDomain "spatial-computing" ;
    vc:standardizedBy ngm:academy-software-foundation ;
    vc:standardizedBy ngm:khronos-group ;
    vc:standardizedBy ngm:metaverse-standards-forum ;
    vc:supports ngm:augmented-reality ;
    vc:supports ngm:game-engine ;
    vc:supports ngm:metaverse-platform ;
    vc:uses ngm:material-x ;
    vc:uses ngm:scene-graph ;
    vc:uses ngm:skeletal-animation .
ngm:3-d-content-creation a owl:Class ;
    rdfs:comment "3D Content Creation encompasses the end-to-end process of designing, modelling, texturing, rigging, and rendering three-dimensional digital assets and environments for use in games, film, XR experiences, and digital twins. It spans artistic and technical disciplines ranging from polygon modelling and UV unwrapping to physically based material authoring and real-time rendering optimisation. The discipline bridges human creative intent and the technical pipelines that deliver interactive or cinematic experiences."@en ;
    rdfs:label "3D Content Creation"@en ;
    rdfs:subClassOf ngm:content-creation ;
    vc:enables ngm:3-d-content-pipeline ;
    vc:enables ngm:digital-twin-creation ;
    vc:enables ngm:xr-applications ;
