# Ontomark / System One (Jev). Copy to .env; never commit real keys.
AGENTBOX_SYSTEM_ONE_PROXY=1            # use the shared proxy; it holds the key, send no Authorization
AGENTBOX_SYSTEM_ONE_ENDPOINT=http://127.0.0.1:8094/v1/systemone  # inside agentbox; host containers on visionclaw_network: http://agentbox:8094/v1/systemone
AGENTBOX_SYSTEM_ONE_MODEL=jev-latest   # the proxy rewrites it to the active backend anyway
AGENTBOX_SYSTEM_ONE_BACKEND_LOCAL=0    # the selected backend is cloud
ONTOMARK_JEV=1                         # enable the Jev consumers
ONTOMARK_JEV_ALLOW_CLOUD=1             # not local-only: proxy and TypeSafe allowed; unset to stay local-only
